# Dependensi
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# Hasil build
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts.timestamp

# Rahasia — jangan pernah ikut ter-commit.
# Berkas ini memuat kunci Supabase; sekali masuk ke riwayat git,
# kuncinya harus dianggap bocor dan wajib diputar ulang.
.env
.env.*
!.env.example

# Skrip peramban sekali pakai (Playwright, pemotret layar) — memang sementara.
/uji-*.mjs
/uji-mobile/

# Berkas /uji-*.ts DULU ikut diabaikan sebagai "uji sementara". Sekarang tidak
# lagi: kedua belas berkasnya sudah menjadi jaring pengaman sungguhan atas
# aturan hak akses, penjaga berkas unggahan, dan perumus metodologi. Uji yang
# tidak ikut tersimpan tidak menjaga apa pun — ia hilang bersama komputer yang
# menjalankannya, dan aturan yang dikuncinya bebas berubah tanpa ketahuan.
# Seluruhnya berdiri sendiri: tanpa jalur mutlak, tanpa berkas contoh dari
# luar, tanpa jaringan. Jalankan dengan: npx tsx uji-<nama>.ts

# Sistem operasi & editor
.DS_Store
Thumbs.db
*.pem
.vercel
.idea/
.vscode/
*.swp

# Log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tsconfig.tsbuildinfo
